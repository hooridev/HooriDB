<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>dev.hoori.db</groupId>
  <artifactId>hooridb-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>HooriDB</name>
  <description>A database manager for the desktop.</description>
  <url>https://db.hoori.dev</url>

  <licenses>
    <license>
      <name>MIT License</name>
      <url>https://opensource.org/license/mit</url>
    </license>
  </licenses>

  <modules>
    <module>core</module>
    <module>app</module>
  </modules>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <!-- How many JVMs a module's tests run in at once, as Surefire's forkCount; each starts its
         own database servers in Docker as its tests ask for them, four containers at most. -->
    <test.forks>4</test.forks>
    <maven.compiler.release>25</maven.compiler.release>
    <!-- The UI framework, https://ui.rethinkj.com, and rethinkj Updater, its core and its helper,
         have no release yet. Each artifact is a SNAPSHOT that changes with each push to its main
         branch; mvn -U fetches the newest. A release pins each to its timestamped SNAPSHOT on its
         own, as they are published at different times (see "Releasing" in AGENTS.md). -->
    <rethinkj-ui-core.version>0.1.0-SNAPSHOT</rethinkj-ui-core.version>
    <rethinkj-ui-kit.version>0.1.0-SNAPSHOT</rethinkj-ui-kit.version>
    <rethinkj-ui-fonts.version>0.1.0-SNAPSHOT</rethinkj-ui-fonts.version>
    <rethinkj-ui-icons.version>0.1.0-SNAPSHOT</rethinkj-ui-icons.version>
    <rethinkj-ui-sql.version>0.1.0-SNAPSHOT</rethinkj-ui-sql.version>
    <rethinkj-ui-json.version>0.1.0-SNAPSHOT</rethinkj-ui-json.version>
    <rethinkj-ui-natives-linux-x64.version>0.1.0-SNAPSHOT</rethinkj-ui-natives-linux-x64.version>
    <rethinkj-ui-natives-windows-x64.version>0.1.0-SNAPSHOT</rethinkj-ui-natives-windows-x64.version>
    <rethinkj-updater-core.version>0.1.0-SNAPSHOT</rethinkj-updater-core.version>
    <rethinkj-updater-helper.version>0.1.0-SNAPSHOT</rethinkj-updater-helper.version>
    <!-- The JDBC drivers that the tests of core load the way the app does, from a folder and not
         from the class path. The app itself downloads whichever version it recommends. -->
    <test.postgresql.version>42.7.14</test.postgresql.version>
    <test.mariadb.version>4.0.0</test.mariadb.version>
    <test.mysql.version>26.10.0</test.mysql.version>
    <!-- The MongoDB driver that core's bridge to it compiles against, and that the tests load
         the way the app does. The app downloads whichever version it recommends. -->
    <mongodb.version>5.15.0</mongodb.version>
  </properties>

  <repositories>
    <repository>
      <id>central-snapshots</id>
      <url>https://central.sonatype.com/repository/maven-snapshots/</url>
      <releases>
        <enabled>false</enabled>
      </releases>
      <snapshots>
        <enabled>true</enabled>
      </snapshots>
    </repository>
  </repositories>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>dev.hoori.db</groupId>
        <artifactId>hooridb-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>dev.hoori.db</groupId>
        <artifactId>hooridb-core</artifactId>
        <version>${project.version}</version>
        <type>test-jar</type>
      </dependency>
      <!-- The kit's own POM asks for its version of core, which a release must pin as well. -->
      <dependency>
        <groupId>com.rethinkj.ui</groupId>
        <artifactId>rethinkj-ui-core</artifactId>
        <version>${rethinkj-ui-core.version}</version>
      </dependency>
      <dependency>
        <groupId>com.rethinkj.ui</groupId>
        <artifactId>rethinkj-ui-kit</artifactId>
        <version>${rethinkj-ui-kit.version}</version>
      </dependency>
      <dependency>
        <groupId>com.rethinkj.ui</groupId>
        <artifactId>rethinkj-ui-fonts</artifactId>
        <version>${rethinkj-ui-fonts.version}</version>
      </dependency>
      <dependency>
        <groupId>com.rethinkj.ui</groupId>
        <artifactId>rethinkj-ui-icons</artifactId>
        <version>${rethinkj-ui-icons.version}</version>
      </dependency>
      <dependency>
        <groupId>com.rethinkj.ui</groupId>
        <artifactId>rethinkj-ui-sql</artifactId>
        <version>${rethinkj-ui-sql.version}</version>
      </dependency>
      <dependency>
        <groupId>com.rethinkj.ui</groupId>
        <artifactId>rethinkj-ui-json</artifactId>
        <version>${rethinkj-ui-json.version}</version>
      </dependency>
      <dependency>
        <groupId>com.rethinkj.ui</groupId>
        <artifactId>rethinkj-ui-natives-linux-x64</artifactId>
        <version>${rethinkj-ui-natives-linux-x64.version}</version>
      </dependency>
      <dependency>
        <groupId>com.rethinkj.ui</groupId>
        <artifactId>rethinkj-ui-natives-windows-x64</artifactId>
        <version>${rethinkj-ui-natives-windows-x64.version}</version>
      </dependency>
      <dependency>
        <groupId>com.rethinkj.updater</groupId>
        <artifactId>rethinkj-updater-core</artifactId>
        <version>${rethinkj-updater-core.version}</version>
      </dependency>
      <dependency>
        <groupId>com.rethinkj.updater</groupId>
        <artifactId>rethinkj-updater-helper</artifactId>
        <version>${rethinkj-updater-helper.version}</version>
      </dependency>
      <dependency>
        <groupId>org.mongodb</groupId>
        <artifactId>mongodb-driver-sync</artifactId>
        <version>${mongodb.version}</version>
      </dependency>
      <dependency>
        <groupId>tools.jackson.core</groupId>
        <artifactId>jackson-databind</artifactId>
        <version>3.3.0</version>
      </dependency>
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers</artifactId>
        <version>2.0.5</version>
      </dependency>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>6.1.3</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <!-- Pinned so that every Maven version builds with the same plugins. -->
    <pluginManagement>
      <plugins>
        <plugin>
          <artifactId>maven-clean-plugin</artifactId>
          <version>3.5.0</version>
        </plugin>
        <plugin>
          <artifactId>maven-resources-plugin</artifactId>
          <version>3.5.0</version>
        </plugin>
        <plugin>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.16.0</version>
        </plugin>
        <plugin>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.6.1</version>
          <configuration>
            <!-- The test classes run in test.forks JVMs at once, each with its own servers and
                 files, and in an order of chance, so that what one class leaves behind for
                 another shows. The log names the order's seed; -Dsurefire.runOrder.random.seed=
                 with it runs the same order again. -->
            <forkCount>${test.forks}</forkCount>
            <reuseForks>true</reuseForks>
            <runOrder>random</runOrder>
            <!-- For the tests against real servers, which load the drivers the way the app does. -->
            <systemPropertyVariables>
              <hooridb.test.drivers>${project.build.directory}/jdbc-drivers</hooridb.test.drivers>
              <hooridb.test.store>${project.build.directory}/test-driver-store-${surefire.forkNumber}</hooridb.test.store>
              <hooridb.test.postgresql.version>${test.postgresql.version}</hooridb.test.postgresql.version>
              <hooridb.test.mariadb.version>${test.mariadb.version}</hooridb.test.mariadb.version>
              <hooridb.test.mysql.version>${test.mysql.version}</hooridb.test.mysql.version>
              <hooridb.test.mongodb.version>${mongodb.version}</hooridb.test.mongodb.version>
            </systemPropertyVariables>
          </configuration>
        </plugin>
        <plugin>
          <!-- The JDBC drivers for the tests against real servers, into a folder of their own: on
               the class path they would bypass the class loader that the app loads them in. A
               module that tests against real servers names the plugin. -->
          <artifactId>maven-dependency-plugin</artifactId>
          <version>3.11.0</version>
          <executions>
            <execution>
              <id>jdbc-drivers</id>
              <phase>generate-test-resources</phase>
              <goals>
                <goal>copy</goal>
              </goals>
              <configuration>
                <outputDirectory>${project.build.directory}/jdbc-drivers</outputDirectory>
                <artifactItems>
                  <artifactItem>
                    <groupId>org.postgresql</groupId>
                    <artifactId>postgresql</artifactId>
                    <version>${test.postgresql.version}</version>
                  </artifactItem>
                  <artifactItem>
                    <groupId>org.mariadb.jdbc</groupId>
                    <artifactId>mariadb-java-client</artifactId>
                    <version>${test.mariadb.version}</version>
                  </artifactItem>
                  <artifactItem>
                    <groupId>com.mysql</groupId>
                    <artifactId>mysql-connector-j</artifactId>
                    <version>${test.mysql.version}</version>
                  </artifactItem>
                  <artifactItem>
                    <groupId>org.mongodb</groupId>
                    <artifactId>mongodb-driver-sync</artifactId>
                    <version>${mongodb.version}</version>
                  </artifactItem>
                  <artifactItem>
                    <groupId>org.mongodb</groupId>
                    <artifactId>mongodb-driver-core</artifactId>
                    <version>${mongodb.version}</version>
                  </artifactItem>
                  <artifactItem>
                    <groupId>org.mongodb</groupId>
                    <artifactId>bson</artifactId>
                    <version>${mongodb.version}</version>
                  </artifactItem>
                  <artifactItem>
                    <groupId>org.mongodb</groupId>
                    <artifactId>bson-record-codec</artifactId>
                    <version>${mongodb.version}</version>
                  </artifactItem>
                </artifactItems>
              </configuration>
            </execution>
          </executions>
        </plugin>
        <plugin>
          <artifactId>maven-jar-plugin</artifactId>
          <version>3.5.1</version>
        </plugin>
        <plugin>
          <artifactId>maven-install-plugin</artifactId>
          <version>3.2.0</version>
        </plugin>
        <plugin>
          <artifactId>maven-deploy-plugin</artifactId>
          <version>3.2.0</version>
        </plugin>
        <plugin>
          <!-- help:evaluate, which the workflows read the version with. -->
          <artifactId>maven-help-plugin</artifactId>
          <version>3.5.1</version>
        </plugin>
        <plugin>
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>build-helper-maven-plugin</artifactId>
          <version>3.6.1</version>
        </plugin>
        <plugin>
          <!-- Runs the app: mvn -q -pl app -am compile exec:exec. Elsewhere it skips, and wants
               an executable even then. -->
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>exec-maven-plugin</artifactId>
          <version>3.6.4</version>
          <configuration>
            <executable>java</executable>
            <skip>true</skip>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <!-- The format of all Java code: mvn spotless:apply writes it, and verify fails on a
             file that is not in it. The same as the UI framework's. -->
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>3.11.0</version>
        <configuration>
          <java>
            <includes>
              <include>src/*/java/**/*.java</include>
            </includes>
            <palantirJavaFormat>
              <version>2.103.0</version>
              <!-- Palantir's breaking of call chains with Google's two spaces and 100 columns. -->
              <style>GOOGLE</style>
            </palantirJavaFormat>
          </java>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>check</goal>
            </goals>
            <phase>verify</phase>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>windows</id>
      <activation>
        <os>
          <family>windows</family>
        </os>
      </activation>
      <properties>
        <!-- jpackage makes the launcher read-only, which a clean cannot delete otherwise. -->
        <maven.clean.force>true</maven.clean.force>
      </properties>
    </profile>
  </profiles>
</project>
