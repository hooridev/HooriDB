<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>dev.hoori.db</groupId>
  <artifactId>hooridb-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>HooriDB</name>
  <description>A database manager for the desktop.</description>
  <url>https://db.hoori.dev</url>

  <modules>
    <module>core</module>
    <module>app</module>
  </modules>

  <properties>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <maven.compiler.release>25</maven.compiler.release>
    <!-- The UI framework, https://ui.rethinkj.com. There is no release of it yet, so this is a
         SNAPSHOT that changes with each push to its main branch; mvn -U fetches the newest. -->
    <rethinkj.ui.version>0.1.0-SNAPSHOT</rethinkj.ui.version>
  </properties>

  <repositories>
    <repository>
      <id>central-snapshots</id>
      <url>https://central.sonatype.com/repository/maven-snapshots/</url>
      <releases>
        <enabled>false</enabled>
      </releases>
      <snapshots>
        <enabled>true</enabled>
      </snapshots>
    </repository>
  </repositories>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>dev.hoori.db</groupId>
        <artifactId>hooridb-core</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>com.rethinkj.ui</groupId>
        <artifactId>rethinkj-ui-kit</artifactId>
        <version>${rethinkj.ui.version}</version>
      </dependency>
      <dependency>
        <groupId>com.rethinkj.ui</groupId>
        <artifactId>rethinkj-ui-fonts</artifactId>
        <version>${rethinkj.ui.version}</version>
      </dependency>
      <dependency>
        <groupId>com.rethinkj.ui</groupId>
        <artifactId>rethinkj-ui-icons</artifactId>
        <version>${rethinkj.ui.version}</version>
      </dependency>
      <dependency>
        <groupId>com.rethinkj.ui</groupId>
        <artifactId>rethinkj-ui-natives-linux-x64</artifactId>
        <version>${rethinkj.ui.version}</version>
      </dependency>
      <dependency>
        <groupId>com.rethinkj.ui</groupId>
        <artifactId>rethinkj-ui-natives-windows-x64</artifactId>
        <version>${rethinkj.ui.version}</version>
      </dependency>
      <dependency>
        <groupId>tools.jackson.core</groupId>
        <artifactId>jackson-databind</artifactId>
        <version>3.3.0</version>
      </dependency>
      <dependency>
        <groupId>org.junit</groupId>
        <artifactId>junit-bom</artifactId>
        <version>6.1.3</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <build>
    <!-- Pinned so that every Maven version builds with the same plugins. -->
    <pluginManagement>
      <plugins>
        <plugin>
          <artifactId>maven-clean-plugin</artifactId>
          <version>3.5.0</version>
        </plugin>
        <plugin>
          <artifactId>maven-resources-plugin</artifactId>
          <version>3.5.0</version>
        </plugin>
        <plugin>
          <artifactId>maven-compiler-plugin</artifactId>
          <version>3.16.0</version>
        </plugin>
        <plugin>
          <artifactId>maven-surefire-plugin</artifactId>
          <version>3.6.1</version>
        </plugin>
        <plugin>
          <artifactId>maven-jar-plugin</artifactId>
          <version>3.5.1</version>
        </plugin>
        <plugin>
          <artifactId>maven-install-plugin</artifactId>
          <version>3.2.0</version>
        </plugin>
        <plugin>
          <artifactId>maven-deploy-plugin</artifactId>
          <version>3.2.0</version>
        </plugin>
        <plugin>
          <!-- Runs the app: mvn -q -pl app -am compile exec:exec. Elsewhere it skips, and wants
               an executable even then. -->
          <groupId>org.codehaus.mojo</groupId>
          <artifactId>exec-maven-plugin</artifactId>
          <version>3.6.4</version>
          <configuration>
            <executable>java</executable>
            <skip>true</skip>
          </configuration>
        </plugin>
      </plugins>
    </pluginManagement>
    <plugins>
      <plugin>
        <!-- The format of all Java code: mvn spotless:apply writes it, and verify fails on a
             file that is not in it. The same as the UI framework's. -->
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>3.11.0</version>
        <configuration>
          <java>
            <includes>
              <include>src/*/java/**/*.java</include>
            </includes>
            <palantirJavaFormat>
              <version>2.103.0</version>
              <!-- Palantir's breaking of call chains with Google's two spaces and 100 columns. -->
              <style>GOOGLE</style>
            </palantirJavaFormat>
          </java>
        </configuration>
        <executions>
          <execution>
            <goals>
              <goal>check</goal>
            </goals>
            <phase>verify</phase>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
