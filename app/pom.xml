<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>dev.hoori.db</groupId>
    <artifactId>hooridb-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>hooridb-app</artifactId>

  <name>HooriDB :: App</name>
  <description>The desktop app: windows and views on rethinkj UI.</description>

  <properties>
    <!-- Arguments for the app when Maven runs it, such as a script in place of the window. -->
    <args></args>
    <!-- The JDK that runs Maven runs the app; the file is named with .exe on Windows. -->
    <java.launcher>${java.home}/bin/java</java.launcher>
    <jpackage>${java.home}/bin/jpackage</jpackage>
    <!-- Where the bundle is built: its input, icon, app image and archive. -->
    <bundle>${project.build.directory}/bundle</bundle>
  </properties>

  <dependencies>
    <dependency>
      <groupId>dev.hoori.db</groupId>
      <artifactId>hooridb-core</artifactId>
    </dependency>
    <!-- The kit brings the framework's core with it. -->
    <dependency>
      <groupId>com.rethinkj.ui</groupId>
      <artifactId>rethinkj-ui-kit</artifactId>
    </dependency>
    <!-- The default fonts and the icon font hold no classes. -->
    <dependency>
      <groupId>com.rethinkj.ui</groupId>
      <artifactId>rethinkj-ui-fonts</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>com.rethinkj.ui</groupId>
      <artifactId>rethinkj-ui-icons</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- The real servers of core's tests, for the app's tests of its seam to them. -->
    <dependency>
      <groupId>dev.hoori.db</groupId>
      <artifactId>hooridb-core</artifactId>
      <type>test-jar</type>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>testcontainers</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <!-- The JDBC drivers for the tests against real servers; see the root POM. -->
        <artifactId>maven-dependency-plugin</artifactId>
      </plugin>
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!-- The tests run on the class path, where the framework is an unnamed module. -->
          <argLine>--enable-native-access=ALL-UNNAMED</argLine>
          <systemPropertyVariables>
            <rethinkj.ui.natives.cache>${project.build.directory}/natives-cache</rethinkj.ui.natives.cache>
          </systemPropertyVariables>
        </configuration>
      </plugin>
      <plugin>
        <!-- Its version, which the app reads from Implementation-Version. -->
        <artifactId>maven-jar-plugin</artifactId>
        <configuration>
          <archive>
            <manifest>
              <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
            </manifest>
          </archive>
        </configuration>
      </plugin>
      <plugin>
        <!-- Runs the app from the folder Maven was started in; see the root POM. The run is the
             execution of the command line, so that the bundle's executions do not inherit it. -->
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <configuration>
          <skip>false</skip>
        </configuration>
        <executions>
          <execution>
            <id>default-cli</id>
            <configuration>
              <executable>${java.launcher}</executable>
              <workingDirectory>${session.executionRootDirectory}</workingDirectory>
              <commandlineArgs>--enable-native-access=ALL-UNNAMED -classpath %classpath dev.hoori.db.app.HooriDb ${args}</commandlineArgs>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>windows</id>
      <activation>
        <os>
          <family>windows</family>
        </os>
      </activation>
      <properties>
        <java.launcher>${java.home}/bin/java.exe</java.launcher>
        <jpackage>${java.home}/bin/jpackage.exe</jpackage>
      </properties>
    </profile>
    <!-- The framework's native libraries for the platform the build runs on. -->
    <profile>
      <id>natives-windows-x64</id>
      <activation>
        <os>
          <family>windows</family>
          <arch>amd64</arch>
        </os>
      </activation>
      <properties>
        <bundle.platform>windows-x64</bundle.platform>
        <bundle.icon>ico</bundle.icon>
        <bundle.java>runtime/bin/java.exe</bundle.java>
        <!-- A real zip, which the updater's helper reads; jar's flags are create, no manifest. -->
        <bundle.pack>${java.home}/bin/jar.exe</bundle.pack>
        <bundle.pack.flags>-cMf</bundle.pack.flags>
        <bundle.archive>zip</bundle.archive>
      </properties>
      <dependencies>
        <dependency>
          <groupId>com.rethinkj.ui</groupId>
          <artifactId>rethinkj-ui-natives-windows-x64</artifactId>
          <scope>runtime</scope>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>natives-linux-x64</id>
      <activation>
        <os>
          <name>Linux</name>
          <arch>amd64</arch>
        </os>
      </activation>
      <properties>
        <bundle.platform>linux-x64</bundle.platform>
        <bundle.icon>png</bundle.icon>
        <bundle.java>lib/runtime/bin/java</bundle.java>
        <!-- tar keeps which files are executable. -->
        <bundle.pack>tar</bundle.pack>
        <bundle.pack.flags>czf</bundle.pack.flags>
        <bundle.archive>tar.gz</bundle.archive>
      </properties>
      <dependencies>
        <dependency>
          <groupId>com.rethinkj.ui</groupId>
          <artifactId>rethinkj-ui-natives-linux-x64</artifactId>
          <scope>runtime</scope>
        </dependency>
      </dependencies>
    </profile>
    <!-- The release bundle of the platform the build runs on: mvn -Pbundle verify. A jpackage
         app image with its own runtime, packed as one archive with the folder HooriDB/ at its
         top; on Windows the installer is made from the image by Inno Setup (src/bundle). -->
    <profile>
      <id>bundle</id>
      <dependencies>
        <!-- Ships with the app, which starts it to replace itself with an update. -->
        <dependency>
          <groupId>com.rethinkj.updater</groupId>
          <artifactId>rethinkj-updater-helper</artifactId>
          <scope>runtime</scope>
        </dependency>
      </dependencies>
      <build>
        <!-- Without the version, as the other JARs, so that the installer's next version
             replaces it by name instead of leaving it beside its own. -->
        <finalName>${project.artifactId}</finalName>
        <plugins>
          <plugin>
            <!-- What an earlier bundle left would end up in this one. -->
            <artifactId>maven-clean-plugin</artifactId>
            <executions>
              <execution>
                <id>bundle</id>
                <phase>initialize</phase>
                <goals>
                  <goal>clean</goal>
                </goals>
                <configuration>
                  <excludeDefaultDirectories>true</excludeDefaultDirectories>
                  <filesets>
                    <fileset>
                      <directory>${bundle}</directory>
                    </fileset>
                  </filesets>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <!-- The version for jpackage, which takes numbers only. -->
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>build-helper-maven-plugin</artifactId>
            <executions>
              <execution>
                <goals>
                  <goal>parse-version</goal>
                </goals>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <!-- What goes into the app's folder: the JARs, the native libraries as a folder that
                 the framework loads them from, and their licenses. -->
            <artifactId>maven-dependency-plugin</artifactId>
            <executions>
              <execution>
                <id>bundle-jars</id>
                <phase>prepare-package</phase>
                <goals>
                  <goal>copy-dependencies</goal>
                </goals>
                <configuration>
                  <includeScope>runtime</includeScope>
                  <excludeArtifactIds>rethinkj-ui-natives-${bundle.platform}</excludeArtifactIds>
                  <stripVersion>true</stripVersion>
                  <outputDirectory>${bundle}/input</outputDirectory>
                </configuration>
              </execution>
              <execution>
                <id>bundle-natives</id>
                <phase>prepare-package</phase>
                <goals>
                  <goal>unpack</goal>
                </goals>
                <configuration>
                  <artifactItems>
                    <artifactItem>
                      <groupId>com.rethinkj.ui</groupId>
                      <artifactId>rethinkj-ui-natives-${bundle.platform}</artifactId>
                      <fileMappers>
                        <org.codehaus.plexus.components.io.filemappers.RegExpFileMapper>
                          <pattern>^META-INF/rethinkj-ui/natives/[^/]+/</pattern>
                          <replacement>natives/</replacement>
                        </org.codehaus.plexus.components.io.filemappers.RegExpFileMapper>
                      </fileMappers>
                    </artifactItem>
                  </artifactItems>
                  <includes>META-INF/rethinkj-ui/natives/${bundle.platform}/*</includes>
                  <excludes>**/licenses</excludes>
                  <outputDirectory>${bundle}/input</outputDirectory>
                  <markersDirectory>${bundle}/markers/natives</markersDirectory>
                </configuration>
              </execution>
              <execution>
                <id>bundle-licenses</id>
                <phase>prepare-package</phase>
                <goals>
                  <goal>unpack</goal>
                </goals>
                <configuration>
                  <artifactItems>
                    <artifactItem>
                      <groupId>com.rethinkj.ui</groupId>
                      <artifactId>rethinkj-ui-natives-${bundle.platform}</artifactId>
                      <fileMappers>
                        <org.codehaus.plexus.components.io.filemappers.RegExpFileMapper>
                          <pattern>^META-INF/rethinkj-ui/natives/[^/]+/licenses/</pattern>
                          <replacement>legal/</replacement>
                        </org.codehaus.plexus.components.io.filemappers.RegExpFileMapper>
                      </fileMappers>
                    </artifactItem>
                  </artifactItems>
                  <includes>META-INF/rethinkj-ui/natives/${bundle.platform}/licenses/*</includes>
                  <outputDirectory>${bundle}/input</outputDirectory>
                  <markersDirectory>${bundle}/markers/licenses</markersDirectory>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <!-- HooriDB's own license, those of rethinkj UI and rethinkj Updater, whose JARs
                 hold none, and Devicon's, whose logos the connection dialog shows. -->
            <artifactId>maven-resources-plugin</artifactId>
            <executions>
              <execution>
                <id>bundle-legal</id>
                <phase>prepare-package</phase>
                <goals>
                  <goal>copy-resources</goal>
                </goals>
                <configuration>
                  <resources>
                    <resource>
                      <directory>src/bundle/legal</directory>
                    </resource>
                    <resource>
                      <directory>${project.basedir}/..</directory>
                      <includes>
                        <include>LICENSE</include>
                      </includes>
                    </resource>
                  </resources>
                  <outputDirectory>${bundle}/input/legal</outputDirectory>
                </configuration>
              </execution>
            </executions>
          </plugin>
          <plugin>
            <artifactId>maven-jar-plugin</artifactId>
            <configuration>
              <outputDirectory>${bundle}/input</outputDirectory>
            </configuration>
          </plugin>
          <plugin>
            <groupId>org.codehaus.mojo</groupId>
            <artifactId>exec-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>bundle-icon</id>
                <phase>package</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <executable>${java.launcher}</executable>
                  <arguments>
                    <argument>--enable-native-access=ALL-UNNAMED</argument>
                    <argument>-Drethinkj.ui.natives.dir=${bundle}/input/natives</argument>
                    <argument>-classpath</argument>
                    <classpath/>
                    <argument>dev.hoori.db.app.BundleIcon</argument>
                    <argument>${bundle}</argument>
                  </arguments>
                </configuration>
              </execution>
              <execution>
                <id>bundle-image</id>
                <phase>package</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <executable>${jpackage}</executable>
                  <arguments>
                    <argument>--type</argument>
                    <argument>app-image</argument>
                    <argument>--name</argument>
                    <argument>HooriDB</argument>
                    <argument>--app-version</argument>
                    <argument>${parsedVersion.majorVersion}.${parsedVersion.minorVersion}.${parsedVersion.incrementalVersion}</argument>
                    <argument>--icon</argument>
                    <argument>${bundle}/HooriDB.${bundle.icon}</argument>
                    <argument>--input</argument>
                    <argument>${bundle}/input</argument>
                    <argument>--main-jar</argument>
                    <argument>${project.build.finalName}.jar</argument>
                    <argument>--vendor</argument>
                    <argument>Patrick Trautmann</argument>
                    <argument>--copyright</argument>
                    <argument>Copyright (C) Patrick Trautmann</argument>
                    <argument>--main-class</argument>
                    <argument>dev.hoori.db.app.HooriDb</argument>
                    <argument>--dest</argument>
                    <argument>${bundle}/image</argument>
                    <!-- Without java.desktop, which Jackson needs only where it is there. -->
                    <argument>--add-modules</argument>
                    <argument>java.base,java.sql,java.net.http,java.naming,java.management,java.security.jgss,java.security.sasl,jdk.security.auth,jdk.security.jgss,jdk.net,jdk.naming.dns,jdk.charsets</argument>
                    <!-- jpackage's own options, but keeping bin/java, which runs the updater's
                         helper, and without links among the legal notices, which it refuses. -->
                    <argument>--jlink-options</argument>
                    <argument>--strip-debug --no-man-pages --no-header-files --disable-plugin dedup-legal-notices</argument>
                    <argument>--java-options</argument>
                    <argument>--enable-native-access=ALL-UNNAMED</argument>
                    <argument>--java-options</argument>
                    <argument>-Drethinkj.ui.natives.dir=$APPDIR/natives</argument>
                  </arguments>
                </configuration>
              </execution>
              <execution>
                <!-- The list of the app's own files, which the updater's helper replaces; run by the
                     image's runtime, which must be able to run the helper. -->
                <id>bundle-files</id>
                <phase>package</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <executable>${bundle}/image/HooriDB/${bundle.java}</executable>
                  <arguments>
                    <argument>-jar</argument>
                    <argument>${bundle}/input/rethinkj-updater-helper.jar</argument>
                    <argument>list</argument>
                    <argument>${bundle}/image/HooriDB</argument>
                  </arguments>
                </configuration>
              </execution>
              <execution>
                <id>bundle-archive</id>
                <phase>package</phase>
                <goals>
                  <goal>exec</goal>
                </goals>
                <configuration>
                  <executable>${bundle.pack}</executable>
                  <arguments>
                    <argument>${bundle.pack.flags}</argument>
                    <argument>${bundle}/HooriDB-${project.version}-${bundle.platform}.${bundle.archive}</argument>
                    <argument>-C</argument>
                    <argument>${bundle}/image</argument>
                    <argument>HooriDB</argument>
                  </arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
