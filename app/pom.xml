<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>dev.hoori.db</groupId>
    <artifactId>hooridb-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
  </parent>

  <artifactId>hooridb-app</artifactId>

  <name>HooriDB :: App</name>
  <description>The desktop app: windows and views on rethinkj UI.</description>

  <properties>
    <!-- Arguments for the app when Maven runs it, such as a script in place of the window. -->
    <args></args>
    <!-- The JDK that runs Maven runs the app; the file is named with .exe on Windows. -->
    <java.launcher>${java.home}/bin/java</java.launcher>
  </properties>

  <dependencies>
    <dependency>
      <groupId>dev.hoori.db</groupId>
      <artifactId>hooridb-core</artifactId>
    </dependency>
    <!-- The kit brings the framework's core with it. -->
    <dependency>
      <groupId>com.rethinkj.ui</groupId>
      <artifactId>rethinkj-ui-kit</artifactId>
    </dependency>
    <!-- The default fonts and the icon font hold no classes. -->
    <dependency>
      <groupId>com.rethinkj.ui</groupId>
      <artifactId>rethinkj-ui-fonts</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>com.rethinkj.ui</groupId>
      <artifactId>rethinkj-ui-icons</artifactId>
      <scope>runtime</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <configuration>
          <!-- The tests run on the class path, where the framework is an unnamed module. -->
          <argLine>--enable-native-access=ALL-UNNAMED</argLine>
          <systemPropertyVariables>
            <rethinkj.ui.natives.cache>${project.build.directory}/natives-cache</rethinkj.ui.natives.cache>
          </systemPropertyVariables>
        </configuration>
      </plugin>
      <plugin>
        <!-- Runs the app from the folder Maven was started in; see the root POM. -->
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <configuration>
          <skip>false</skip>
          <executable>${java.launcher}</executable>
          <workingDirectory>${session.executionRootDirectory}</workingDirectory>
          <commandlineArgs>--enable-native-access=ALL-UNNAMED -classpath %classpath dev.hoori.db.app.HooriDb ${args}</commandlineArgs>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>windows</id>
      <activation>
        <os>
          <family>windows</family>
        </os>
      </activation>
      <properties>
        <java.launcher>${java.home}/bin/java.exe</java.launcher>
      </properties>
    </profile>
    <!-- The framework's native libraries for the platform the build runs on. -->
    <profile>
      <id>natives-windows-x64</id>
      <activation>
        <os>
          <family>windows</family>
          <arch>amd64</arch>
        </os>
      </activation>
      <dependencies>
        <dependency>
          <groupId>com.rethinkj.ui</groupId>
          <artifactId>rethinkj-ui-natives-windows-x64</artifactId>
          <scope>runtime</scope>
        </dependency>
      </dependencies>
    </profile>
    <profile>
      <id>natives-linux-x64</id>
      <activation>
        <os>
          <name>Linux</name>
          <arch>amd64</arch>
        </os>
      </activation>
      <dependencies>
        <dependency>
          <groupId>com.rethinkj.ui</groupId>
          <artifactId>rethinkj-ui-natives-linux-x64</artifactId>
          <scope>runtime</scope>
        </dependency>
      </dependencies>
    </profile>
  </profiles>
</project>
